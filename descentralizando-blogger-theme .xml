<!-- ════════════ POST INDIVIDUAL ════════════ -->
<b:if cond='data:view.isPost'>
  <div class='contenedor'>
    <div class='layout-2col'>

      <article class='post-individual'>
        <b:section class='main' id='main-post' maxwidgets='1' showaddelement='no'>
          <b:widget id='Blog2' locked='true' title='Entrada' type='Blog' version='2'>
            <b:includable id='main' var='top'>
              <b:loop values='data:posts' var='post'>
                <b:include data='post' name='postCompleto'/>
              </b:loop>
            </b:includable>

            <b:includable id='postCompleto' var='post'>
              <div class='post-eyebrow'>
                <b:loop values='data:post.labels' var='label'>
                  <a class='badge' expr:href='data:label.url'><data:label.name/></a>
                </b:loop>
              </div>

              <h1 class='post-titulo-principal'><data:post.title/></h1>

              <div class='post-dateline'>
                <span>📅 <data:post.dateHeader/></span>
                <span>✍️ <strong><data:post.author.name/></strong></span>
                <b:if cond='data:post.allowComments'>
                  <a expr:href='data:post.url + &quot;#comments&quot;'
                    style='color:var(--verde);text-decoration:none;'>
                    💬 <data:post.numComments/> comentarios
                  </a>
                </b:if>
              </div>

              <b:if cond='data:post.featuredImage'>
                <div class='post-img-dest'>
                  <img expr:alt='data:post.title'
                    expr:src='data:post.featuredImage'
                    loading='eager' decoding='async'
                    style='width:100%;max-height:500px;object-fit:cover;object-position:center top;display:block;'/>
                </div>
              </b:if>

              <div class='post-body' expr:id='"post-body-" + data:post.id'>
                <data:post.body/>
              </div>

              <div class='post-labels-footer'>
                <span>Categorías:</span>
                <b:loop values='data:post.labels' var='label'>
                  <a class='badge' expr:href='data:label.url'><data:label.name/></a>
                </b:loop>
              </div>

              <div class='compartir-caja'>
                <p class='compartir-titulo'>📤 Compartir este artículo</p>
                <div class='compartir-btns'>
                  <a class='btn-compartir btn-fb'
                    expr:href='&quot;https://www.facebook.com/sharer/sharer.php?u=&quot; + data:post.url'
                    rel='noopener noreferrer' target='_blank'>f Facebook</a>
                  <a class='btn-compartir btn-tw'
                    expr:href='&quot;https://twitter.com/intent/tweet?url=&quot; + data:post.url + &quot;&amp;text=&quot; + data:post.title'
                    rel='noopener noreferrer' target='_blank'>𝕏 Twitter</a>
                  <a class='btn-compartir btn-wa'
                    expr:href='&quot;https://wa.me/?text=&quot; + data:post.title + &quot; &quot; + data:post.url'
                    rel='noopener noreferrer' target='_blank'>📱 WhatsApp</a>
                </div>
              </div>

              <b:if cond='data:post.allowComments'>
                <section aria-label='Comentarios' style='margin-top:3rem;'>
                  <h2 style='font-family:var(--f-titulo);font-size:var(--t-2xl);
                    color:var(--texto-1);margin-bottom:1.5rem;
                    border-bottom:2px solid var(--borde);padding-bottom:1rem;'>
                    💬 Comentarios (<data:post.numComments/>)
                  </h2>
                  <b:include data='post' name='comments'/>
                </section>
              </b:if>
            </b:includable>

            <b:includable id='comments' var='post'>
              <div id='comments'>
                <b:loop values='data:post.comments' var='comment'>
                  <div class='comentario-item'>
                    <div class='comentario-autor'><data:comment.author.name/></div>
                    <div class='comentario-fecha'><data:comment.timestamp/></div>
                    <div class='comentario-cuerpo'><data:comment.body/></div>
                  </div>
                </b:loop>
                <b:if cond='data:post.embedCommentForm'>
                  <div id='comment-editor'></div>
                </b:if>
              </div>
            </b:includable>
          </b:widget>
        </b:section>
      </article>

      <!-- Sidebar post individual -->
      <aside aria-label='Barra lateral' class='sidebar'>
        <div class='widget-card widget-card-accent'>
          <div class='widget-header'>
            <span class='widget-header-icon'>🔥</span>
            <span class='widget-header-titulo'>Más noticias</span>
          </div>
          <div class='widget-body' id='dm-populares-post'>
            <p style='color:var(--texto-4);font-size:var(--t-sm);'>Cargando...</p>
          </div>
        </div>
        <div class='widget-card'>
          <div class='widget-header'>
            <span class='widget-header-icon'>📂</span>
            <span class='widget-header-titulo'>Categorías</span>
          </div>
          <div class='widget-body'>
            <div class='etiquetas-nube'>
              <a class='etiqueta-btn' expr:href='data:blog.homepageUrl + &quot;search/label/Pol%C3%ADtica&quot;'>Política</a>
              <a class='etiqueta-btn' expr:href='data:blog.homepageUrl + &quot;search/label/Social&quot;'>Social</a>
              <a class='etiqueta-btn' expr:href='data:blog.homepageUrl + &quot;search/label/Tecnolog%C3%ADa&quot;'>Tecnología</a>
              <a class='etiqueta-btn' expr:href='data:blog.homepageUrl + &quot;search/label/Econom%C3%ADa&quot;'>Economía 4.0</a>
              <a class='etiqueta-btn' expr:href='data:blog.homepageUrl + &quot;search/label/Turismo&quot;'>Turismo</a>
              <a class='etiqueta-btn' expr:href='data:blog.homepageUrl + &quot;search/label/Blockchain&quot;'>Blockchain</a>
            </div>
          </div>
        </div>
      </aside>

    </div>
  </div>
</b:if>
<!-- ════════════ FIN POST INDIVIDUAL ════════════ -->


<!-- ════════════ BÚSQUEDA / ETIQUETA ════════════ -->
<b:if cond='data:view.isSearch'>
  <div class='page-header'>
    <div class='contenedor'>
      <b:if cond='data:view.search.label'>
        <div class='page-header-badge'>
          <span class='badge'>📂 Categoría</span>
        </div>
        <h1 class='page-header-titulo'><data:view.search.label/></h1>
        <p class='page-header-desc'>Todas las publicaciones sobre <data:view.search.label/></p>
      <b:else/>
        <div class='page-header-badge'>
          <span class='badge'>🔍 Búsqueda</span>
        </div>
        <h1 class='page-header-titulo'>Resultados de búsqueda</h1>
      </b:if>
    </div>
  </div>

  <div class='contenedor' style='padding-bottom:3rem;'>
    <b:section class='main' id='main-search' maxwidgets='1' showaddelement='no'>
      <b:widget id='Blog3' locked='true' title='Resultados' type='Blog' version='2'>
        <b:includable id='main' var='top'>
          <div class='grilla-noticias'>
            <b:loop values='data:posts' var='post'>
              <b:include data='post' name='searchCard'/>
            </b:loop>
          </div>
          <div class='blog-pager'><b:include name='nextprev'/></div>
        </b:includable>

        <b:includable id='searchCard' var='post'>
          <article class='noticia-card'>
            <a class='noticia-thumb' expr:href='data:post.url' style='display:block;text-decoration:none;'>
              <b:if cond='data:post.featuredImage'>
                <img expr:alt='data:post.title'
                  expr:src='data:post.featuredImage'
                  loading='lazy' decoding='async'
                  style='position:absolute;inset:0;width:100%;height:100%;
                    object-fit:cover;object-position:center top;'/>
              <b:else/>
                <div class='img-placeholder'>🗺️</div>
              </b:if>
              <b:if cond='data:post.labels'>
                <b:loop values='data:post.labels' var='label' index='li'>
                  <b:if cond='data:li == 0'>
                    <span class='badge' style='position:absolute;top:0.75rem;left:0.75rem;z-index:2;'>
                      <data:label.name/>
                    </span>
                  </b:if>
                </b:loop>
              </b:if>
            </a>
            <div class='noticia-body'>
              <h2 class='noticia-titulo'>
                <a expr:href='data:post.url'><data:post.title/></a>
              </h2>
              <div class='noticia-meta'>
                <span>📅 <data:post.dateHeader/></span>
                <span class='noticia-sep'>·</span>
                <span class='noticia-autor'><data:post.author.name/></span>
              </div>
            </div>
          </article>
        </b:includable>

        <b:includable id='nextprev'>
          <b:if cond='data:newerPageUrl'>
            <a class='blog-pager-newer-link' expr:href='data:newerPageUrl'>← Más recientes</a>
          </b:if>
          <b:if cond='data:olderPageUrl'>
            <a class='blog-pager-older-link' expr:href='data:olderPageUrl'>Más antiguas →</a>
          </b:if>
        </b:includable>
      </b:widget>
    </b:section>
  </div>
</b:if>
<!-- ════════════ FIN BÚSQUEDA ════════════ -->

</main>


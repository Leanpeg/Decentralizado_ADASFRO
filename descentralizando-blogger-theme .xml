<!-- ════════════ HOMEPAGE ════════════ -->
<b:if cond='data:view.isHomepage'>

  <!--
    ╔═══════════════════════════════════════════════════════╗
    ║  FUENTE DE DATOS PARA JS — posts en data-* atributos  ║
    ║  Blogger renderiza esto, JS lo lee del DOM al instante ║
    ║  SIN llamada JSONP → sin demora, sin fallo             ║
    ╚═══════════════════════════════════════════════════════╝
  -->
  <div aria-hidden='true' id='dm-posts-data' style='display:none;'>
    <b:section class='main' id='main' maxwidgets='1' showaddelement='no'>
      <b:widget id='Blog1' locked='true' title='Entradas de blog' type='Blog' version='2'>
        <b:widget-settings>
          <b:widget-setting name='showDateHeader'>false</b:widget-setting>
          <b:widget-setting name='showShareButtons'>false</b:widget-setting>
          <b:widget-setting name='showLabels'>true</b:widget-setting>
          <b:widget-setting name='showCommentLink'>false</b:widget-setting>
          <b:widget-setting name='showAuthor'>true</b:widget-setting>
          <b:widget-setting name='showTimestamp'>true</b:widget-setting>
          <b:widget-setting name='showSnippets'>false</b:widget-setting>
          <b:widget-setting name='showImageUrl'>true</b:widget-setting>
          <b:widget-setting name='numItemsAtIndex'>10</b:widget-setting>
        </b:widget-settings>
        <b:includable id='main' var='top'>
          <b:loop values='data:posts' var='post'>
            <b:include data='post' name='postData'/>
          </b:loop>
          <div class='blog-pager' id='blog-pager' style='display:none;'>
            <b:include name='nextprev'/>
          </div>
        </b:includable>

        <!--
          Cada post genera un div.dm-post-item con todos los datos necesarios.
          featuredImage es la imagen que el autor subió → calidad original.
        -->
        <b:includable id='postData' var='post'>
          <div class='dm-post-item'
            expr:data-url='data:post.url'
            expr:data-titulo='data:post.title'
            expr:data-fecha='data:post.dateHeader'
            expr:data-autor='data:post.author.name'
            expr:data-img='data:post.featuredImage'>
            <b:loop values='data:post.labels' var='label' index='labelIdx'>
              <b:if cond='data:labelIdx == 0'>
                <span class='dm-post-label'><data:label.name/></span>
              </b:if>
            </b:loop>
          </div>
        </b:includable>

        <b:includable id='nextprev'>
          <b:if cond='data:newerPageUrl'>
            <a class='blog-pager-newer-link' expr:href='data:newerPageUrl'>← Publicaciones recientes</a>
          </b:if>
          <b:if cond='data:olderPageUrl'>
            <a class='blog-pager-older-link' expr:href='data:olderPageUrl'>Publicaciones anteriores →</a>
          </b:if>
        </b:includable>
      </b:widget>
    </b:section>
  </div>
  <!-- FIN fuente de datos -->


            <polygon points='8,3.5 8,10.5 14,7' fill='white'/>
          </svg>
          Videos ADASFRO
        </h2>
        <a class='seccion-ver-todos' href='https://www.youtube.com/@descentralizando_adasfro' rel='noopener noreferrer' target='_blank' aria-label='Ver canal de YouTube de Descentralizando'>Ver canal</a>
      </div>

      <!-- Contenedor carrusel -->
      <div class='yt-carrusel-wrap' aria-label='Carrusel de videos'>
        <button aria-label='Video anterior' class='yt-btn yt-btn-prev' id='yt-prev' type='button'>&#8249;</button>

        <div class='yt-pista-outer' id='yt-pista-outer'>
          <div class='yt-pista' id='yt-pista'>
            <!-- JS carga automáticamente los videos del canal ADASFRO via RSS -->
            <div class='yt-cargando' id='yt-cargando' style='width:100%;padding:3rem;text-align:center;color:var(--texto-3);font-family:var(--f-cuerpo);'>
              ⏳ Cargando videos de ADASFRO...

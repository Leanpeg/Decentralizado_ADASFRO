<!-- ═══════════════════════ CONTENIDO PRINCIPAL ═══════════════════════ -->
<main id='contenido-principal' role='main'>

<!-- ════ HOMEPAGE ════ -->
<b:if cond='data:view.isHomepage'>

  <!-- Hero grid: JS lo llena con las últimas entradas -->
  <section class='hero' aria-label='Noticias destacadas'>
    <div class='contenedor'>
      <div class='hero-grid' id='dm-hero-grid'>
        <div style='grid-column:1/-1;min-height:350px;display:flex;align-items:center;justify-content:center;background:var(--fondo-3);border-radius:var(--r-lg);border:1px solid var(--borde);'>
          <span style='color:var(--texto-3);font-family:var(--f-cuerpo);font-size:var(--t-sm);'>⏳ Cargando noticias destacadas...</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Layout 2 columnas -->
  <div class='contenedor'>
    <div class='layout-2col'>

      <!-- Columna principal -->
      <div>
        <section aria-labelledby='titulo-recientes'>
          <div class='seccion-header' data-animar='arriba'>
            <h2 class='seccion-titulo' id='titulo-recientes'>📰 Noticias Recientes</h2>
            <a class='seccion-ver-todos' expr:href='data:blog.homepageUrl' aria-label='Ver todas las noticias'>Ver todas</a>
          </div>
          <!-- JS llena este contenedor -->
          <div class='grilla-noticias' id='dm-noticias-recientes'>
            <div style='grid-column:1/-1;padding:3rem;text-align:center;color:var(--texto-3);background:var(--fondo-2);border-radius:var(--r-lg);border:1px solid var(--borde);'>
              ⏳ Cargando publicaciones...
            </div>
          </div>
        </section>

        <!-- Blog widget OCULTO — requerido por Blogger para funcionar -->
        <div aria-hidden='true' style='display:none;'>
          <b:section class='main' id='main' maxwidgets='1' showaddelement='no'>
            <b:widget id='Blog1' locked='true' title='Entradas de blog' type='Blog' version='2'>
              <b:widget-settings>
                <b:widget-setting name='showDateHeader'>false</b:widget-setting>
                <b:widget-setting name='showShareButtons'>true</b:widget-setting>
                <b:widget-setting name='showLabels'>true</b:widget-setting>
                <b:widget-setting name='showCommentLink'>true</b:widget-setting>
                <b:widget-setting name='showAuthor'>true</b:widget-setting>
                <b:widget-setting name='showTimestamp'>true</b:widget-setting>
                <b:widget-setting name='showSnippets'>false</b:widget-setting>
                <b:widget-setting name='showImageUrl'>true</b:widget-setting>
              </b:widget-settings>
              <b:includable id='main' var='top'>
                <div class='blog-posts'>
                  <b:loop values='data:posts' var='post'>
                    <b:include data='post' name='post'/>
                  </b:loop>
                </div>
                <div class='blog-pager'><b:include name='nextprev'/></div>
              </b:includable>
              <b:includable id='post' var='post'>
                <article class='post' expr:id='"post-" + data:post.id'>
                  <data:post.title/>
                </article>
              </b:includable>
              <b:includable id='nextprev'>
                <b:if cond='data:newerPageUrl'>
                  <a class='blog-pager-newer-link' expr:href='data:newerPageUrl'>← Publicaciones recientes</a>
                </b:if>
                <b:if cond='data:olderPageUrl'>
                  <a class='blog-pager-older-link' expr:href='data:olderPageUrl'>Publicaciones anteriores →</a>
                </b:if>
              </b:includable>
            </b:widget>
          </b:section>
        </div>

      </div><!-- /columna principal -->

      <!-- SIDEBAR -->
      <aside class='sidebar' aria-label='Barra lateral'>

        <!-- Lo más reciente -->
        <div class='widget-card widget-card-accent' data-animar='arriba'>
          <div class='widget-header'>
            <span class='widget-header-icon' aria-hidden='true'>🔥</span>
            <span class='widget-header-titulo'>Lo más reciente</span>
          </div>
          <div class='widget-body' id='dm-populares'>
            <p style='color:var(--texto-4);font-size:var(--t-sm);'>Cargando...</p>
          </div>
        </div>

        <!-- Categorías -->
        <div class='widget-card' data-animar='arriba' data-retraso='100'>
          <div class='widget-header'>
            <span class='widget-header-icon' aria-hidden='true'>📂</span>
            <span class='widget-header-titulo'>Categorías</span>
          </div>
          <div class='widget-body'>
            <nav aria-label='Navegación por categorías'>
              <div class='etiquetas-nube'>
                <a class='etiqueta-btn' expr:href='data:blog.homepageUrl + &quot;search/label/Pol%C3%ADtica&quot;' style='border-color:#1e40af;color:#1e40af;'>🏛️ Política</a>
                <a class='etiqueta-btn' expr:href='data:blog.homepageUrl + &quot;search/label/Social&quot;' style='border-color:#6d28d9;color:#6d28d9;'>👥 Social</a>
                <a class='etiqueta-btn' expr:href='data:blog.homepageUrl + &quot;search/label/Tecnolog%C3%ADa&quot;' style='border-color:#0369a1;color:#0369a1;'>💻 Tecnología</a>
                <a class='etiqueta-btn' expr:href='data:blog.homepageUrl + &quot;search/label/Econom%C3%ADa&quot;' style='border-color:#b45309;color:#b45309;'>📈 Economía 4.0</a>
                <a class='etiqueta-btn' expr:href='data:blog.homepageUrl + &quot;search/label/Turismo&quot;' style='border-color:#047857;color:#047857;'>🌿 Turismo</a>
                <a class='etiqueta-btn' expr:href='data:blog.homepageUrl + &quot;search/label/Blockchain&quot;' style='border-color:#7c3aed;color:#7c3aed;'>⛓️ Blockchain</a>
                <a class='etiqueta-btn' expr:href='data:blog.homepageUrl + &quot;search/label/Descentralizaci%C3%B3n&quot;' style='border-color:#7c3aed;color:#7c3aed;'>🌐 Descentralización</a>
                <a class='etiqueta-btn' expr:href='data:blog.homepageUrl + &quot;search/label/Inclusi%C3%B3n&quot;' style='border-color:#6d28d9;color:#6d28d9;'>♿ Inclusión</a>
                <a class='etiqueta-btn' expr:href='data:blog.homepageUrl + &quot;search/label/Gobernanza&quot;' style='border-color:#1e40af;color:#1e40af;'>⚖️ Gobernanza</a>
              </div>
            </nav>
            <!-- Widget nativo (genera etiquetas reales de Blogger) -->
            <div style='display:none;'>
              <b:section id='sidebar-labels'>
                <b:widget id='Label1' title='Etiquetas' type='Label' version='2'/>
              </b:section>
            </div>
          </div>
        </div>

        <!-- Sobre nosotros -->
        <div class='widget-card widget-sobre' data-animar='arriba' data-retraso='200'>
          <div class='widget-header'>
            <span class='widget-header-icon' aria-hidden='true'>🏛️</span>
            <span class='widget-header-titulo'>Quiénes somos</span>
          </div>
          <div class='widget-body'>
            <div class='widget-sobre-logo'>
              <div class='widget-sobre-logo-box' aria-hidden='true'>📖</div>
              <div>
                <div class='widget-sobre-nombre'>Descentralizando</div>
                <div class='widget-sobre-sub'>por ADASFRO</div>
              </div>
            </div>
            <p style='font-size:var(--t-sm);color:var(--texto-3);line-height:1.65;'>
              Medio digital informativo sobre economía 4.0, descentralización, 
              tecnología e inclusión en Costa Rica y la región. Accesible, libre y comunitario.
            </p>
            <div class='widget-cedula'>
              🏛️ Cédula Jurídica: 3-002-860094
            </div>
            <a href='mailto:descentralizando@adasfro.org' style='display:inline-flex;align-items:center;gap:0.4rem;margin-top:0.75rem;font-family:var(--f-ui);font-size:var(--t-xs);font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--verde);text-decoration:none;transition:color 0.2s;'>
              📧 Contactarnos
            </a>
          </div>
        </div>

        <!-- Suscripción -->
        <div class='widget-card' id='suscribir' data-animar='arriba' data-retraso='300'>
          <div class='widget-header'>
            <span class='widget-header-icon' aria-hidden='true'>📩</span>
            <span class='widget-header-titulo'>Suscribirse</span>
          </div>
          <div class='widget-body'>
            <div class='sub-form-inner'>
              <p>Recibí noticias sobre economía 4.0 y descentralización en tu correo. Gratis.</p>
              <!-- Widget nativo Blogger de suscripción por email -->
              <b:section id='sidebar-follow'>
                <b:widget id='FollowByEmail1' title='Suscripción' type='FollowByEmail' version='2'/>
              </b:section>
            </div>
          </div>
        </div>

      </aside><!-- /sidebar -->

    </div><!-- /layout-2col -->
  </div><!-- /contenedor -->

</b:if>
<!-- ════ FIN HOMEPAGE ════ -->


<!-- ════ POST INDIVIDUAL ════ -->
<b:if cond='data:view.isPost'>
  <div class='contenedor'>
    <div class='layout-2col'>

      <article class='post-individual'>
        <b:section class='main' id='main-post' maxwidgets='1' showaddelement='no'>
          <b:widget id='Blog2' locked='true' title='Entrada' type='Blog' version='2'>
            <b:includable id='main' var='top'>
              <b:loop values='data:posts' var='post'>
                <b:include data='post' name='postCompleto'/>
              </b:loop>
            </b:includable>
            <b:includable id='postCompleto' var='post'>

              <div class='post-eyebrow'>
                <b:loop values='data:post.labels' var='label'>
                  <a class='badge' expr:href='data:label.url'><data:label.name/></a>
                </b:loop>
              </div>

              <h1 class='post-titulo-principal'><data:post.title/></h1>

              <div class='post-dateline'>
                <span>📅 <data:post.dateHeader/></span>
                <span>✍️ <strong><data:post.author.name/></strong></span>
                <b:if cond='data:post.allowComments'>
                  <a expr:href='data:post.url + &quot;#comments&quot;' style='color:var(--verde);text-decoration:none;'>
                    💬 <data:post.numComments/> comentarios
                  </a>
                </b:if>
              </div>

              <b:if cond='data:post.featuredImage'>
                <div class='post-img-dest'>
                  <img expr:alt='data:post.title' expr:src='data:post.featuredImage' loading='eager' decoding='async' style='width:100%;max-height:480px;object-fit:cover;object-position:center top;'/>
                </div>
              </b:if>

              <div class='post-body' expr:id='"post-body-" + data:post.id'>
                <data:post.body/>
              </div>

              <div class='post-labels-footer'>
                <span>Categorías:</span>
                <b:loop values='data:post.labels' var='label'>
                  <a class='badge' expr:href='data:label.url'><data:label.name/></a>
                </b:loop>
              </div>

              <!-- Compartir -->
              <div class='compartir-caja'>
                <p class='compartir-titulo'>📤 Compartir este artículo</p>
                <div class='compartir-btns'>
                  <a class='btn-compartir btn-fb' expr:href='&quot;https://www.facebook.com/sharer/sharer.php?u=&quot; + data:post.url' rel='noopener noreferrer' target='_blank'>f Facebook</a>
                  <a class='btn-compartir btn-tw' expr:href='&quot;https://twitter.com/intent/tweet?url=&quot; + data:post.url + &quot;&amp;text=&quot; + data:post.title' rel='noopener noreferrer' target='_blank'>𝕏 Twitter</a>
                  <a class='btn-compartir btn-wa' expr:href='&quot;https://wa.me/?text=&quot; + data:post.title + &quot; &quot; + data:post.url' rel='noopener noreferrer' target='_blank'>📱 WhatsApp</a>
                </div>
              </div>

              <!-- Comentarios -->
              <b:if cond='data:post.allowComments'>
                <section aria-label='Comentarios' style='margin-top:3rem;'>
                  <h2 style='font-family:var(--f-titulo);font-size:var(--t-2xl);color:var(--texto-1);margin-bottom:1.5rem;display:flex;align-items:center;gap:0.6rem;border-bottom:2px solid var(--borde);padding-bottom:1rem;'>
                    💬 Comentarios (<data:post.numComments/>)
                  </h2>
                  <b:include data='post' name='comments'/>
                </section>
              </b:if>

            </b:includable>
            <b:includable id='comments' var='post'>
              <div id='comments'>
                <b:loop values='data:post.comments' var='comment'>
                  <div class='comentario-item'>
                    <div class='comentario-autor'><data:comment.author.name/></div>
                    <div class='comentario-fecha'><data:comment.timestamp/></div>
                    <div class='comentario-cuerpo'><data:comment.body/></div>
                  </div>
                </b:loop>
                <b:if cond='data:post.embedCommentForm'>
                  <div id='comment-editor'></div>
                </b:if>
              </div>
            </b:includable>
          </b:widget>
        </b:section>
      </article>

      <!-- Sidebar post individual -->
      <aside class='sidebar' aria-label='Barra lateral'>
        <div class='widget-card widget-card-accent'>
          <div class='widget-header'>
            <span class='widget-header-icon'>🔥</span>
            <span class='widget-header-titulo'>Más noticias</span>
          </div>
          <div class='widget-body' id='dm-populares-post'>
            <p style='color:var(--texto-4);font-size:var(--t-sm);'>Cargando...</p>
          </div>

<!DOCTYPE html>
<html b:css='false' b:defaultwidgetversion='2' b:layoutsVersion='3' b:responsive='true' b:templateUrl='custom.xml' b:templateVersion='2.0.0' expr:dir='data:blog.languageDirection' expr:lang='data:blog.locale' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>

<!--
=================================================================
  DESCENTRALIZANDO · Blogger Theme v4.0
  ADASFRO · Cédula 3-002-860094 · Orosi, Cartago, CR
  Economía 4.0 · Accesibilidad Universal · WCAG AA

  CSS: https://leanpeg.github.io/Decentralizado_ADASFRO/descentralizando-styles.css
  JS:  https://leanpeg.github.io/Decentralizado_ADASFRO/descentralizando-script.js

  CAMBIOS v4:
  ✅ Paleta clara (blanco/crema + verde + azul marino + dorado)
  ✅ Imágenes nítidas (resolución alta, sin redimensionado borroso)
  ✅ Accesibilidad WCAG AA/AAA
  ✅ Fuentes: DM Serif Display + IBM Plex Sans + Oswald
=================================================================
-->

<head>
  <meta charset='UTF-8'/>
  <meta content='width=device-width, initial-scale=1.0' name='viewport'/>
  <b:include data='blog' name='all-head-content'/>

  <title><data:blog.pageTitle/></title>
  <b:if cond='data:blog.metaDescription'>
    <meta expr:content='data:blog.metaDescription' name='description'/>
  </b:if>
  <meta content='descentralización, economía 4.0, ADASFRO, Costa Rica, blockchain, accesibilidad, inclusión' name='keywords'/>
  <meta content='ADASFRO – Agencia para el Desarrollo Accesible sin Fronteras' name='author'/>
  <meta content='Descentralizando por ADASFRO' property='og:site_name'/>
  <meta expr:content='data:blog.pageTitle' property='og:title'/>
  <meta content='website' property='og:type'/>

  <!-- Google Fonts: DM Serif Display + IBM Plex Sans + Oswald -->
  <link href='https://fonts.googleapis.com' rel='preconnect'/>
  <link crossorigin='anonymous' href='https://fonts.gstatic.com' rel='preconnect'/>
  <link href='https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&amp;family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&amp;family=Oswald:wght@400;500;600;700&amp;display=swap' rel='stylesheet'/>

  <!-- CSS desde GitHub Pages -->
  <link href='https://leanpeg.github.io/Decentralizado_ADASFRO/descentralizando-styles.css' rel='stylesheet'/>

  <b:skin><![CDATA[
/* Blogger reset mínimo */
body { margin:0; padding:0; background:#f8f9fa; }
.widget { display:block; }
#header-wrapper,.header-outer,#header { display:none !important; }
/* Ocultar render nativo de posts en homepage (JS los muestra) */
.home-page .blog-posts .post { display:none !important; }
/* Mostrar normal en post individual y búsqueda */
.item-view .blog-posts .post,
.post-page .blog-posts .post,
.search-page .blog-posts .post { display:block !important; }
  ]]></b:skin>
</head>

<body>

<a class='saltar-contenido' href='#contenido-principal'>Saltar al contenido principal</a>


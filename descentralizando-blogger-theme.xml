<!-- ═══════════════════════ BÚSQUEDA ═══════════════════════ -->
<div aria-label='Búsqueda en el sitio' class='busqueda-overlay' id='busqueda-overlay' role='dialog' aria-modal='true'>
  <button aria-label='Cerrar buscador' class='busqueda-cerrar' id='busqueda-cerrar' type='button'>✕</button>

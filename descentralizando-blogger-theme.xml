<!DOCTYPE html>
<html b:css='false' b:defaultwidgetversion='2' b:layoutsVersion='3' b:responsive='true' b:templateUrl='custom.xml' b:templateVersion='2.0.0' expr:dir='data:blog.languageDirection' expr:lang='data:blog.locale' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>

<!--
=================================================================
  DESCENTRALIZANDO — Tema Blogger v3.0
  Medio Digital de ADASFRO · Economía 4.0 · Costa Rica
  Cédula Jurídica: 3-002-860094

  CSS: https://leanpeg.github.io/Decentralizado_ADASFRO/descentralizando-styles.css
  JS:  https://leanpeg.github.io/Decentralizado_ADASFRO/descentralizando-script.js

  Fuentes: DM Serif Display + IBM Plex Sans + Oswald (Google Fonts)

  CÓMO INSTALAR:
  1. Blogger → Tema → Editar HTML
  2. Seleccionar todo (Ctrl+A) → Borrar → Pegar este archivo
  3. Guardar
=================================================================
-->

<head>
  <meta charset='UTF-8'/>
  <meta content='width=device-width, initial-scale=1.0' name='viewport'/>
  <b:include data='blog' name='all-head-content'/>

  <!-- SEO -->
  <title><data:blog.pageTitle/></title>
  <b:if cond='data:blog.metaDescription'>
    <meta expr:content='data:blog.metaDescription' name='description'/>
  </b:if>
  <meta content='descentralización, economía 4.0, ADASFRO, Costa Rica, blockchain, tecnología, inclusión digital' name='keywords'/>
  <meta content='ADASFRO – Agencia para el Desarrollo Accesible sin Fronteras' name='author'/>

  <!-- Open Graph -->
  <meta expr:content='data:blog.pageTitle' property='og:title'/>
  <meta content='Descentralizando por ADASFRO' property='og:site_name'/>
  <meta content='website' property='og:type'/>
  <b:if cond='data:blog.url'>
    <meta expr:content='data:blog.url' property='og:url'/>
  </b:if>

  <!-- Google Fonts: DM Serif Display + IBM Plex Sans + Oswald -->
  <link href='https://fonts.googleapis.com' rel='preconnect'/>
  <link crossorigin='anonymous' href='https://fonts.gstatic.com' rel='preconnect'/>
  <link href='https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&amp;family=IBM+Plex+Sans:wght@300;400;500;600&amp;family=Oswald:wght@400;500;600;700&amp;display=swap' rel='stylesheet'/>

  <!-- CSS desde GitHub Pages -->
  <link href='https://leanpeg.github.io/Decentralizado_ADASFRO/descentralizando-styles.css' rel='stylesheet'/>

  <!-- CSS mínimo para Blogger (no puede estar en archivo externo) -->
  <b:skin><![CDATA[
/* Blogger overrides — mínimos necesarios */
body { margin:0; padding:0; }
.widget { display:block; }
/* Ocultar header nativo de Blogger */
#header-wrapper, .header-outer, #header { display:none !important; }
/* Ocultar post nativo en homepage (lo mostramos con JS) */
#main-wrapper .blog-posts .post { display:none !important; }
/* Mostrar post en página individual */
.item-view .blog-posts .post,
.post-page .blog-posts .post { display:block !important; }
  ]]></b:skin>
</head>

<body>

<!-- Accesibilidad: saltar al contenido -->
<a class='saltar-contenido' href='#contenido-principal'>Saltar al contenido</a>


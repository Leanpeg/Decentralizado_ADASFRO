<!-- ════════ HOMEPAGE ════════ -->
<b:if cond='data:view.isHomepage'>

  <!-- HERO: Grid de noticias destacadas (llenado por JS) -->
  <section aria-label='Noticias destacadas' class='hero'>
    <div class='contenedor'>
      <div class='hero-grid' id='dm-hero-grid'>
        <!-- Placeholder mientras carga -->
        <div style='grid-column:1/-1;min-height:300px;display:flex;align-items:center;justify-content:center;background:var(--negro-card);border-radius:var(--r-lg);'>
          <span style='color:var(--gris-400);font-family:var(--f-cuerpo);font-size:var(--t-sm);'>⏳ Cargando portada...</span>
        </div>
      </div>
    </div>
  </section>

  <!-- LAYOUT 2 COLUMNAS -->
  <div class='contenedor'>
    <div class='layout-2col'>

      <!-- COLUMNA PRINCIPAL -->
      <div>
        <!-- Noticias Recientes -->
        <section aria-labelledby='titulo-recientes'>
          <div class='seccion-header' data-animar='arriba'>
            <h2 class='seccion-titulo' id='titulo-recientes'>📰 Noticias Recientes</h2>
            <a class='seccion-ver-todos' expr:href='data:blog.homepageUrl'>Ver todas</a>
          </div>
          <div class='grilla-noticias' id='dm-noticias-recientes'>
            <div style='grid-column:1/-1;padding:2rem;text-align:center;color:var(--gris-400);font-family:var(--f-cuerpo);'>
              ⏳ Cargando publicaciones...
            </div>
          </div>
        </section>

        <!-- Widget de Blogger NECESARIO para que funcione el blog
             Lo ocultamos visualmente pero Blogger lo requiere -->
        <div aria-hidden='true' style='display:none;'>
          <b:section class='main' id='main' maxwidgets='1' showaddelement='no'>
            <b:widget id='Blog1' locked='true' title='Entradas de blog' type='Blog' version='2'>
              <b:widget-settings>
                <b:widget-setting name='showDateHeader'>false</b:widget-setting>
                <b:widget-setting name='showShareButtons'>true</b:widget-setting>
                <b:widget-setting name='showLabels'>true</b:widget-setting>
                <b:widget-setting name='showCommentLink'>true</b:widget-setting>
                <b:widget-setting name='showAuthor'>true</b:widget-setting>
                <b:widget-setting name='showTimestamp'>true</b:widget-setting>
                <b:widget-setting name='showSnippets'>false</b:widget-setting>
                <b:widget-setting name='showImageUrl'>true</b:widget-setting>
              </b:widget-settings>
              <b:includable id='main' var='top'>
                <div class='blog-posts'>
                  <b:loop values='data:posts' var='post'>
                    <b:include data='post' name='post'/>
                  </b:loop>
                </div>
                <div class='blog-pager' id='blog-pager'>
                  <b:include name='nextprev'/>
                </div>
              </b:includable>
              <b:includable id='post' var='post'>
                <article class='post' expr:id='"post-" + data:post.id'>
                  <data:post.title/>
                </article>
              </b:includable>
              <b:includable id='nextprev'>
                <b:if cond='data:newerPageUrl'>
                  <a class='blog-pager-newer-link' expr:href='data:newerPageUrl'>← Publicaciones recientes</a>
                </b:if>
                <b:if cond='data:olderPageUrl'>
                  <a class='blog-pager-older-link' expr:href='data:olderPageUrl'>Publicaciones anteriores →</a>
                </b:if>
              </b:includable>
            </b:widget>
          </b:section>
        </div>

      </div><!-- /columna principal -->

      <!-- SIDEBAR -->
      <aside aria-label='Barra lateral' class='sidebar'>

        <!-- Lo más leído -->
        <div class='widget-card' data-animar='arriba'>
          <div class='widget-header'>
            <span class='widget-header-icon' aria-hidden='true'>🔥</span>
            <span class='widget-header-titulo'>Lo más reciente</span>
          </div>
          <div class='widget-body' id='dm-populares'>
            <div style='color:var(--gris-400);font-size:var(--t-sm);'>Cargando...</div>
          </div>
        </div>

        <!-- Categorías -->
        <div class='widget-card' data-animar='arriba' data-retraso='100'>
          <div class='widget-header'>
            <span class='widget-header-icon' aria-hidden='true'>📂</span>
            <span class='widget-header-titulo'>Categorías</span>
          </div>
          <div class='widget-body'>
            <div class='etiquetas-nube'>
              <a class='etiqueta-btn' expr:href='data:blog.homepageUrl + &quot;search/label/Pol%C3%ADtica&quot;'>Política</a>
              <a class='etiqueta-btn' expr:href='data:blog.homepageUrl + &quot;search/label/Social&quot;'>Social</a>
              <a class='etiqueta-btn' expr:href='data:blog.homepageUrl + &quot;search/label/Tecnolog%C3%ADa&quot;'>Tecnología</a>
              <a class='etiqueta-btn' expr:href='data:blog.homepageUrl + &quot;search/label/Econom%C3%ADa&quot;'>Economía 4.0</a>
              <a class='etiqueta-btn' expr:href='data:blog.homepageUrl + &quot;search/label/Turismo&quot;'>Turismo</a>
              <a class='etiqueta-btn' expr:href='data:blog.homepageUrl + &quot;search/label/Blockchain&quot;'>Blockchain</a>
              <a class='etiqueta-btn' expr:href='data:blog.homepageUrl + &quot;search/label/Descentralizaci%C3%B3n&quot;'>Descentralización</a>
              <a class='etiqueta-btn' expr:href='data:blog.homepageUrl + &quot;search/label/Inclusi%C3%B3n&quot;'>Inclusión</a>
              <a class='etiqueta-btn' expr:href='data:blog.homepageUrl + &quot;search/label/Gobernanza&quot;'>Gobernanza</a>
            </div>

            <!-- Widget nativo de etiquetas de Blogger (oculto, genera las etiquetas reales) -->
            <div style='display:none;'>
              <b:section id='sidebar-labels'>
                <b:widget id='Label1' title='Etiquetas' type='Label' version='2'/>
              </b:section>
            </div>
          </div>
        </div>

        <!-- Sobre nosotros -->
        <div class='widget-card' data-animar='arriba' data-retraso='200'>
          <div class='widget-header'>
            <span class='widget-header-icon' aria-hidden='true'>🏛️</span>
            <span class='widget-header-titulo'>Quiénes somos</span>
          </div>
          <div class='widget-body'>
            <div class='widget-sobre-logo'>
              <div class='widget-sobre-logo-box' aria-hidden='true'>🗺️</div>
              <div>
                <div class='widget-sobre-nombre'>Descentralizando</div>
                <div class='widget-sobre-sub'>por ADASFRO</div>
              </div>
            </div>
            <p style='font-size:var(--t-sm);color:var(--gris-400);line-height:1.65;margin-bottom:0.75rem;'>
              Medio digital informativo enfocado en la economía 4.0, descentralización, 
              tecnología e inclusión en Costa Rica y la región.
            </p>
            <div class='widget-cedula'>🏛️ Cédula Jurídica: 3-002-860094</div>
            <p style='font-size:var(--t-xs);color:var(--gris-600);margin-top:0.6rem;line-height:1.5;'>
              Ley N.º 218 · Art. 28, 29, 46 Constitución · Art. 139 Código Electoral
            </p>
          </div>
        </div>

        <!-- Suscripción -->
        <div class='widget-card' id='suscribir' data-animar='arriba' data-retraso='300'>
          <div class='widget-header'>
            <span class='widget-header-icon' aria-hidden='true'>📩</span>
            <span class='widget-header-titulo'>Suscribirse</span>
          </div>
          <div class='widget-body'>
            <div class='widget-sub-form'>
              <p>Recibí noticias sobre economía 4.0 y descentralización directamente en tu correo.</p>
              <!-- Widget nativo de Blogger para suscripción por email -->
              <b:section id='sidebar-follow'>
                <b:widget id='FollowByEmail1' title='Suscripción por correo' type='FollowByEmail' version='2'/>
              </b:section>
            </div>
          </div>
        </div>

        <!-- PopularPosts widget nativo (oculto) -->
        <div style='display:none;' aria-hidden='true'>
          <b:section id='sidebar-popular'>
            <b:widget id='PopularPosts1' title='Populares' type='PopularPosts' version='2'>
              <b:widget-settings>
                <b:widget-setting name='numItemsToShow'>5</b:widget-setting>
                <b:widget-setting name='showThumbnails'>false</b:widget-setting>
                <b:widget-setting name='showSnippets'>false</b:widget-setting>
              </b:widget-settings>
            </b:widget>
          </b:section>
        </div>

      </aside><!-- /sidebar -->

    </div><!-- /layout-2col -->
  </div><!-- /contenedor -->

</b:if>
<!-- ════════ FIN HOMEPAGE ════════ -->


<!-- ════════ PÁGINA DE ENTRADA INDIVIDUAL ════════ -->
<b:if cond='data:view.isPost'>
  <div class='contenedor'>
    <div class='layout-2col'>

      <!-- Artículo -->
      <article class='post-individual'>
        <b:section class='main' id='main-post' maxwidgets='1' showaddelement='no'>
          <b:widget id='Blog2' locked='true' title='Entrada' type='Blog' version='2'>
            <b:includable id='main' var='top'>
              <b:loop values='data:posts' var='post'>
                <b:include data='post' name='postCompleto'/>
              </b:loop>
            </b:includable>

            <b:includable id='postCompleto' var='post'>
              <!-- Eyebrow / etiquetas -->
              <div class='post-eyebrow'>
                <b:loop values='data:post.labels' var='label'>
                  <a class='badge' expr:href='data:label.url'><data:label.name/></a>
                </b:loop>
              </div>

              <!-- Título -->
              <h1 class='post-titulo-principal'><data:post.title/></h1>

              <!-- Meta -->
              <div class='post-dateline'>
                <span>📅 <data:post.dateHeader/></span>
                <span>✍️ <strong><data:post.author.name/></strong></span>
                <b:if cond='data:post.allowComments'>
                  <a expr:href='data:post.url + &quot;#comments&quot;' style='color:var(--esmeralda);text-decoration:none;'>
                    💬 <data:post.numComments/> comentarios
                  </a>
                </b:if>
              </div>

              <!-- Imagen destacada si existe -->
              <b:if cond='data:post.featuredImage'>
                <div class='post-imagen-destacada'>
                  <img expr:alt='data:post.title' expr:src='data:post.featuredImage' loading='eager'/>
                </div>
              </b:if>

              <!-- Cuerpo del artículo -->
              <div class='post-body' expr:id='"post-body-" + data:post.id'>
                <data:post.body/>
              </div>

              <!-- Footer: etiquetas -->
              <div class='post-labels-footer'>
                <span>Categorías:</span>
                <b:loop values='data:post.labels' var='label'>
                  <a class='badge' expr:href='data:label.url'><data:label.name/></a>
                </b:loop>
              </div>

              <!-- Compartir -->
              <div style='margin-top:1.5rem;padding:1rem;background:var(--negro-panel);border-radius:var(--r-md);border:1px solid var(--negro-borde);'>
                <p style='font-family:var(--f-ui);font-size:var(--t-xs);text-transform:uppercase;letter-spacing:0.1em;color:var(--gris-400);margin-bottom:0.75rem;'>Compartir este artículo</p>
                <div style='display:flex;gap:0.75rem;flex-wrap:wrap;'>
                  <a expr:href='&quot;https://www.facebook.com/sharer/sharer.php?u=&quot; + data:post.url' rel='noopener' style='font-family:var(--f-ui);font-size:var(--t-xs);font-weight:700;text-transform:uppercase;padding:6px 14px;background:#1877f2;color:#fff;border-radius:var(--r-sm);text-decoration:none;' target='_blank'>Facebook</a>
                  <a expr:href='&quot;https://twitter.com/intent/tweet?url=&quot; + data:post.url + &quot;&amp;text=&quot; + data:post.title' rel='noopener' style='font-family:var(--f-ui);font-size:var(--t-xs);font-weight:700;text-transform:uppercase;padding:6px 14px;background:#000;color:#fff;border-radius:var(--r-sm);text-decoration:none;' target='_blank'>Twitter/X</a>
                  <a expr:href='&quot;https://wa.me/?text=&quot; + data:post.title + &quot; &quot; + data:post.url' rel='noopener' style='font-family:var(--f-ui);font-size:var(--t-xs);font-weight:700;text-transform:uppercase;padding:6px 14px;background:#25d366;color:#fff;border-radius:var(--r-sm);text-decoration:none;' target='_blank'>WhatsApp</a>
                </div>
              </div>

              <!-- Comentarios -->
              <b:if cond='data:post.allowComments'>
                <section aria-label='Comentarios' style='margin-top:3rem;'>
                  <h2 style='font-family:var(--f-titulo);font-size:var(--t-2xl);color:var(--blanco);margin-bottom:1.5rem;display:flex;align-items:center;gap:0.75rem;'>
                    💬 Comentarios (<data:post.numComments/>)
                  </h2>
                  <b:include data='post' name='comments'/>
                </section>
              </b:if>
            </b:includable>

            <b:includable id='comments' var='post'>
              <div id='comments'>
                <b:loop values='data:post.comments' var='comment'>
                  <div class='comentario-item'>
                    <div class='comentario-autor'><data:comment.author.name/></div>
                    <div class='comentario-fecha'><data:comment.timestamp/></div>
                    <div class='comentario-cuerpo'><data:comment.body/></div>
                  </div>
                </b:loop>
